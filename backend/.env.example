# Completar con los datos del relay SMTP autorizado por el Centro de Datos.
# Copiar este archivo a backend/.env. No guardar credenciales en el repositorio.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=CyberDefense AI
SMTP_USE_SSL=false
SMTP_STARTTLS=true
SMTP_TIMEOUT=15

# BAJA, MEDIA, ALTA o CRÍTICA. Se usa la misma escala basada en confianza del panel.
EMAIL_MIN_SEVERITY=BAJA

# Agrupa correos repetidos con el mismo tipo/origen/destino/puerto/acción.
EMAIL_DEDUP_SECONDS=60
EMAIL_SUBJECT_PREFIX=[CyberDefense AI]
