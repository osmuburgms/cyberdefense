<?xml version="1.0" encoding="UTF-8"?>
<vnx xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="/usr/share/xml/vnx/vnx-2.00.xsd">
  <global>
    <version>2.0</version>
    <scenario_name>datacenter_sdn</scenario_name>
    <automac offset="0"/>
    <vm_mgmt type="private" network="10.250.0.0" mask="24" offset="12">
      <host_mapping />
    </vm_mgmt>
  </global>

  <!-- Salida externa temporal de aprovisionamiento; eth1 se apaga al configurar cada objetivo. -->
  <net name="virbr0" mode="virtual_bridge" managed="no"/>

  <!-- Un switch OpenFlow con tres VLAN de acceso. -->
  <net name="SDN_Net" mode="openvswitch" controller="tcp:127.0.0.1:6653" of_version="OpenFlow13"/>

  <!-- Servidores: VLAN 10, 192.168.1.0/24. -->
  <vm name="server1" type="lxc" arch="x86_64">
    <filesystem type="cow">/usr/share/vnx/filesystems/rootfs_lxc_ubuntu64</filesystem>
    <if id="1" net="SDN_Net"><vlan><tag id="10"/></vlan><ipv4>192.168.1.10/24</ipv4></if>
    <if id="2" net="virbr0"><ipv4>dhcp</ipv4></if>
    <exec seq="on_boot" type="verbatim">echo "root:root" | chpasswd</exec>
  </vm>
  <vm name="server2" type="lxc" arch="x86_64">
    <filesystem type="cow">/usr/share/vnx/filesystems/rootfs_lxc_ubuntu64</filesystem>
    <if id="1" net="SDN_Net"><vlan><tag id="10"/></vlan><ipv4>192.168.1.11/24</ipv4></if>
    <if id="2" net="virbr0"><ipv4>dhcp</ipv4></if>
    <exec seq="on_boot" type="verbatim">echo "root:root" | chpasswd</exec>
  </vm>
  <vm name="server3" type="lxc" arch="x86_64">
    <filesystem type="cow">/usr/share/vnx/filesystems/rootfs_lxc_ubuntu64</filesystem>
    <if id="1" net="SDN_Net"><vlan><tag id="10"/></vlan><ipv4>192.168.1.12/24</ipv4></if>
    <if id="2" net="virbr0"><ipv4>dhcp</ipv4></if>
    <exec seq="on_boot" type="verbatim">echo "root:root" | chpasswd</exec>
  </vm>
  <vm name="server4" type="lxc" arch="x86_64">
    <filesystem type="cow">/usr/share/vnx/filesystems/rootfs_lxc_ubuntu64</filesystem>
    <if id="1" net="SDN_Net"><vlan><tag id="10"/></vlan><ipv4>192.168.1.13/24</ipv4></if>
    <if id="2" net="virbr0"><ipv4>dhcp</ipv4></if>
    <exec seq="on_boot" type="verbatim">echo "root:root" | chpasswd</exec>
  </vm>
  <vm name="server5" type="lxc" arch="x86_64">
    <filesystem type="cow">/usr/share/vnx/filesystems/rootfs_lxc_ubuntu64</filesystem>
    <if id="1" net="SDN_Net"><vlan><tag id="10"/></vlan><ipv4>192.168.1.14/24</ipv4></if>
    <if id="2" net="virbr0"><ipv4>dhcp</ipv4></if>
    <exec seq="on_boot" type="verbatim">echo "root:root" | chpasswd</exec>
  </vm>

  <!-- Laboratorio 1: VLAN 20, 192.168.20.0/24. -->
  <vm name="lab1pc1" type="lxc" arch="x86_64">
    <filesystem type="cow">/usr/share/vnx/filesystems/rootfs_lxc_ubuntu64</filesystem>
    <if id="1" net="SDN_Net"><vlan><tag id="20"/></vlan><ipv4>192.168.20.11/24</ipv4></if>
    <if id="2" net="virbr0"><ipv4>dhcp</ipv4></if>
    <exec seq="on_boot" type="verbatim">echo "root:root" | chpasswd</exec>
  </vm>
  <vm name="lab1pc2" type="lxc" arch="x86_64">
    <filesystem type="cow">/usr/share/vnx/filesystems/rootfs_lxc_ubuntu64</filesystem>
    <if id="1" net="SDN_Net"><vlan><tag id="20"/></vlan><ipv4>192.168.20.12/24</ipv4></if>
    <if id="2" net="virbr0"><ipv4>dhcp</ipv4></if>
    <exec seq="on_boot" type="verbatim">echo "root:root" | chpasswd</exec>
  </vm>

  <!-- Laboratorio 2: VLAN 30, 192.168.30.0/24. -->
  <vm name="lab2pc1" type="lxc" arch="x86_64">
    <filesystem type="cow">/usr/share/vnx/filesystems/rootfs_lxc_ubuntu64</filesystem>
    <if id="1" net="SDN_Net"><vlan><tag id="30"/></vlan><ipv4>192.168.30.11/24</ipv4></if>
    <if id="2" net="virbr0"><ipv4>dhcp</ipv4></if>
    <exec seq="on_boot" type="verbatim">echo "root:root" | chpasswd</exec>
  </vm>
  <vm name="lab2pc2" type="lxc" arch="x86_64">
    <filesystem type="cow">/usr/share/vnx/filesystems/rootfs_lxc_ubuntu64</filesystem>
    <if id="1" net="SDN_Net"><vlan><tag id="30"/></vlan><ipv4>192.168.30.12/24</ipv4></if>
    <if id="2" net="virbr0"><ipv4>dhcp</ipv4></if>
    <exec seq="on_boot" type="verbatim">echo "root:root" | chpasswd</exec>
  </vm>

  <!-- El atacante tiene un puerto de acceso por VLAN y una NIC externa. -->
  <vm name="attacker" type="lxc" arch="x86_64">
    <filesystem type="cow">/usr/share/vnx/filesystems/rootfs_lxc_ubuntu64</filesystem>
    <if id="1" net="SDN_Net"><vlan><tag id="10"/></vlan><ipv4>192.168.1.50/24</ipv4></if>
    <if id="2" net="SDN_Net"><vlan><tag id="20"/></vlan><ipv4>192.168.20.50/24</ipv4></if>
    <if id="3" net="SDN_Net"><vlan><tag id="30"/></vlan><ipv4>192.168.30.50/24</ipv4></if>
    <if id="4" net="virbr0"><ipv4>dhcp</ipv4></if>
    <exec seq="on_boot" type="verbatim">echo "root:root" | chpasswd</exec>
  </vm>
</vnx>
